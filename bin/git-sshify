#!/usr/bin/env node

var shell = require('shelljs');
shell.config.silent = true;

var remote = process.argv[2] || 'origin';

// TODO(nfischer): replace `stdout.split` with `.toArray` when it's supported.
var line = shell.cmd('git', 'remote', '-v').grep(remote).stdout.split('\n')[0];

var regex = new RegExp(`${remote}.*(https://github.com/([a-zA-Z0-9-]+)/([a-zA-Z0-9._-]+))`, '');
var match = line.match(regex);
if (match) {
  var oldRemoteUrl = match[1];
  var user = match[2];
  var repo = match[3];
  repo = repo.replace(/\.git$/, '');
  shell.config.silent = false;
  var newRemoteUrl = `git@github.com:${user}/${repo}.git`;
  console.log(oldRemoteUrl, ' -> ', newRemoteUrl);
  var ret = shell.cmd('git', 'remote', 'set-url', remote, newRemoteUrl);
  if (ret.code === 0) {
    console.log('Done');
  } else {
    console.error('Failure');
    process.exit(1);
  }
} else if (line.match(/git@github.com/)) {
  console.log("This is already ssh-format.");
} else {
  console.error("This doesn't appear to be http");
  process.exit(1);
}
